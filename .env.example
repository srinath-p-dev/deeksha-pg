# Copy this file to .env and fill in real values. .env is git-ignored.

# --- PostgreSQL (used by docker-compose to create the database) ---
POSTGRES_USER=pgapp
POSTGRES_PASSWORD=change_me
POSTGRES_DB=pgapp

# --- Backend (FastAPI) ---
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg://pgapp:change_me@127.0.0.1:5433/pgapp
APP_TIMEZONE=Asia/Kolkata
ENVIRONMENT=development

# --- Frontend (Next.js) ---
# Where Next.js reaches FastAPI from the server side
API_INTERNAL_URL=http://localhost:8000
