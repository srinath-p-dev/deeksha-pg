# Production settings for the VPS. Copy to .env on the server and fill in.
# Generate secrets with:  openssl rand -hex 24
# Use letters/digits only for the DB password (it goes into a URL).

DOMAIN=yourpg.duckdns.org

POSTGRES_USER=pgapp
POSTGRES_PASSWORD=CHANGE_ME_long_random_hex
POSTGRES_DB=pgapp

# Shared secret between the API/worker and the WhatsApp service
WHATSAPP_TOKEN=CHANGE_ME_long_random_hex

APP_TIMEZONE=Asia/Kolkata

# Schedules (IST)
REMINDER_DAYS=5-8
REMINDER_TIME=17:00
REMINDER_CUTOFF_TIME=21:00
OWNER_REPORT_DAY=9
OWNER_REPORT_TIME=10:00

# Anti-ban pacing
WA_MIN_DELAY_SECONDS=8
WA_MAX_DELAY_SECONDS=20
WA_DAILY_LIMIT=250

# Email for "WhatsApp disconnected" alerts (Gmail: create an App Password at
# https://myaccount.google.com/apppasswords — needs 2-step verification on)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Nightly backups (see scripts/backup.sh). rclone remote name + folder.
BACKUP_PASSPHRASE=CHANGE_ME_long_random_hex
BACKUP_REMOTE=gdrive:pg-backups
